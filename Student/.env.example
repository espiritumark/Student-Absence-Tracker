# Vision LLM — screenshot import (required for Screenshot tab)
#
# Free local option (recommended): install Ollama, then run:
#   ollama pull qwen2.5vl:7b
VITE_VISION_LLM_API_KEY=ollama
VITE_VISION_LLM_BASE_URL=http://localhost:11434/v1
VITE_VISION_LLM_MODEL=qwen2.5vl:7b
#
# Optional speed tuning (local Ollama — smaller image = faster scans):
# VITE_VISION_MAX_IMAGE_WIDTH=1280
# VITE_VISION_MAX_IMAGE_HEIGHT=2200
# VITE_VISION_JPEG_QUALITY=0.82
# VITE_VISION_MAX_TOKENS=4096
# VITE_VISION_KEEP_ALIVE=15m
# Faster model (less accurate): ollama pull qwen2.5vl:3b then set VITE_VISION_LLM_MODEL=qwen2.5vl:3b
#
# Cloud option (DashScope Qwen VL):
# VITE_VISION_LLM_API_KEY=your_dashscope_api_key
# VITE_VISION_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# VITE_VISION_LLM_MODEL=qwen2.5-vl-32b-instruct
