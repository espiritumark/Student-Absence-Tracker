# Supabase (required for cloud sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Vision LLM — screenshot import
#
# This Device (free, local — best on your PC with Ollama):
#   ollama pull qwen2.5vl:7b
VITE_VISION_LLM_API_KEY=ollama
VITE_VISION_LLM_BASE_URL=http://localhost:11434/v1
VITE_VISION_LLM_MODEL=qwen2.5vl:7b
#
# Optional speed tuning (local Ollama):
# VITE_VISION_MAX_IMAGE_WIDTH=1280
# VITE_VISION_MAX_IMAGE_HEIGHT=2200
# VITE_VISION_JPEG_QUALITY=0.82
# VITE_VISION_MAX_TOKENS=4096
# VITE_VISION_KEEP_ALIVE=15m
#
# Feedback tab — optional AI refine (text model):
# VITE_FEEDBACK_LLM_MODEL=llama3.2
#
# -----------------------------------------------------------------------------
# Cloud API — OpenRouter + Nemotron VL (free, high-quality OCR for screenshots)
# https://openrouter.ai/settings/keys
# -----------------------------------------------------------------------------
#
# Vercel production (recommended): only ONE secret required on the server:
#   VISION_CLOUD_API_KEY=sk-or-v1-...
# Optional overrides (defaults are OpenRouter + nvidia/nemotron-nano-12b-v2-vl:free):
#   VISION_CLOUD_PROVIDER=openrouter
#   VISION_CLOUD_BASE_URL=https://openrouter.ai/api/v1
#   VISION_CLOUD_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
#
# Production builds auto-use the /api/vision-scan proxy (no VITE_ key in the browser).
# To force proxy in local dev: VITE_VISION_CLOUD_MODE=proxy  (run: npx vercel dev)
#
# Dev-only — call OpenRouter from the browser (do NOT use on Vercel):
# VITE_VISION_CLOUD_MODE=direct
# VITE_VISION_CLOUD_API_KEY=sk-or-v1-...
# VITE_VISION_CLOUD_BASE_URL=https://openrouter.ai/api/v1
# VITE_VISION_CLOUD_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
